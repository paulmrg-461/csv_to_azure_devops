ORGANIZATION=
PROJECT=
AZURE_DEVOPS_PAT=
DEEPSEEK_API_KEY=
# Modelo por defecto de DeepSeek (si se omite): deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Proveedor de IA: 'deepseek' (default) o 'groq' =====
# Groq expone el mismo contrato OpenAI. Rellena solo la clave del proveedor que uses.
AI_PROVIDER=deepseek
GROQ_API_KEY=
# Modelo de Groq (debe existir en tu cuenta). Ej: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
# Archivo de entrada: .csv o .xlsx (detectado por extensión)
INPUT_FILE=tasks.csv
# Separador CSV (por defecto TAB). Para comas: CSV_SEPARATOR=,
# CSV_SEPARATOR=,
